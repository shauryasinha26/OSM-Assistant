# Frontend API URL (safe to expose; not a secret)
VITE_API_BASE_URL=http://localhost:8000

# Backend-only secret: replace the placeholder with your Google AI Studio API key.
# NEVER rename this to VITE_GEMINI_API_KEY.
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
